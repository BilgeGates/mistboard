{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "watchPatterns": [
      "/apps/server/**",
      "/apps/web/**",
      "/packages/game/**",
      "/packages/board-render/**",
      "/scripts/**",
      "/package.json",
