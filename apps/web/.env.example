# Copy to apps/web/.env (gitignored) and fill in real values.
# Same values go into Railway env vars for production.

# PostHog analytics. Public project key — embedded in client JS at build time.
# Get from https://app.posthog.com → project settings → "Project API Key".
VITE_POSTHOG_KEY=phc_REPLACE_ME

# PostHog ingestion host. US: https://us.i.posthog.com  EU: https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Admin-only engine review surface. Keep false for public production builds.
VITE_ENABLE_ENGINE_LAB=false
