# Local-only symlink for the ?bakeoff browser route. Points at a bake-off
# output directory under /tmp; not part of the repo.
apps/web/public/bakeoff

# Engine/lab bakeoff exports belong in the private mistboard-engine repo.
lab-exports/

# Versioned bake-off output dirs (per Tier-1 release). These are ignored
# because they are large local artifacts, not because they are disposable.
# If a run produces annotations, screenshots, hard-fact findings, or build-log
# evidence, archive/inventory it under docs-private/engine-track before deleting
# a worktree or reusing the save dir. See docs/fog-of-war/engine-lab-loop.md.
apps/web/public/bakeoff-*

# Tournament run output dirs (timestamped per-run game logs + manifests,
# multi-MB each). Local-only artifact; archive/inventory meaningful runs before
# cleanup.
research/python-fow-lab/tournaments/

# Private founder/operator notes. Public docs should be contributor-safe.
docs-private/
.claude/

# Repo uses npm, not pnpm. Stray pnpm-lock files are accidental artifacts.
pnpm-lock.yaml

# AI-generated pixel-art + animation experiments. Large (~100MB), reproducible
# from prompts via scripts/pixel-gen.mjs and scripts/video-gen.mjs. The
# DEV-only /pixel-lab page references these assets; regenerate locally with
# REPLICATE_API_TOKEN + OPENAI_API_KEY to view them.
apps/web/public/pixel-lab/
apps/web/public/pixel-lab-assets/

# Local scratch dir: mobile-test screenshots (scripts/mobile-loop.mjs) and
# other dev-loop output (e.g. web-port.txt). Never part of the repo.
tmp/
