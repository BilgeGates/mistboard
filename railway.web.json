{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "watchPatterns": [
      "/apps/server/**",
      "/apps/web/**",
      "/packages/game/**",
      "/packages/board-render/**",
      "/scripts/**",
      "/package.json",
      "/package-lock.json",
      "/nixpacks.toml",
      "/railpack.json",
      "/railway.web.json",
      "/tsconfig.base.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30
  }
}
