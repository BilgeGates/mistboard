{
  "name": "bichess",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @bichess/server & npm run dev --workspace @bichess/web",
    "build": "npm run build --workspace=@bichess/game && npm run build --workspace=@bichess/server && npm run build --workspace=@bichess/web",
    "build:all": "npm run build --workspaces",
    "start": "node apps/server/dist/index.js",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "visual:check": "node scripts/visual-check.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
