{
  "name": "bichess",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @bichess/server & npm run dev --workspace @bichess/web",
    "dev:persistent": "npm run dev:persistent --workspace @bichess/server & npm run dev --workspace @bichess/web",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "env DATABASE_URL=postgres://bichess:bichess@localhost:5435/bichess npm run migrate --workspace @bichess/server",
    "test:persistent": "env TEST_DATABASE_URL=postgres://bichess:bichess@localhost:5435/bichess npm run test --workspace @bichess/server",
    "build": "node scripts/build.mjs",
    "build:all": "npm run build --workspaces",
    "start": "node scripts/start.mjs",
    "engine:enqueue": "npm run engine:enqueue --workspace=@bichess/server",
    "engine:enqueue-smoke": "npm run engine:enqueue-smoke --workspace=@bichess/server",
    "engine:queue-status": "npm run engine:queue-status --workspace=@bichess/server",
    "worker": "npm run worker --workspace=@bichess/server",
    "worker:execute": "npm run worker:execute --workspace=@bichess/server",
    "worker:service": "npm run worker:service --workspace=@bichess/server",
    "worker:dev": "npm run worker:dev --workspace=@bichess/server",
    "worker:dev:execute": "npm run worker:dev:execute --workspace=@bichess/server",
    "worker:dev:service": "npm run worker:dev:service --workspace=@bichess/server",
    "engine:artifact-audit": "node scripts/engine-artifact-audit.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "hooks:install": "git config core.hooksPath .githooks",
    "visual:check": "node scripts/visual-check.mjs",
    "engine:capture-beliefs": "node scripts/capture-belief-artifacts.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
