{
  "name": "bichess",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @bichess/server & npm run dev --workspace @bichess/web",
    "build": "npm run build --workspace=@bichess/game && npm run build --workspace=@bichess/server && npm run build --workspace=@bichess/web",
    "build:all": "npm run build --workspaces",
    "start": "node scripts/start.mjs",
    "engine:enqueue-smoke": "npm run engine:enqueue-smoke --workspace=@bichess/server",
    "worker": "npm run worker --workspace=@bichess/server",
    "worker:execute": "npm run worker:execute --workspace=@bichess/server",
    "worker:service": "npm run worker:service --workspace=@bichess/server",
    "worker:dev": "npm run worker:dev --workspace=@bichess/server",
    "worker:dev:execute": "npm run worker:dev:execute --workspace=@bichess/server",
    "worker:dev:service": "npm run worker:dev:service --workspace=@bichess/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "hooks:install": "git config core.hooksPath .githooks",
    "visual:check": "node scripts/visual-check.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
