{
  "name": "mistboard",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mistboard/server & npm run dev --workspace @mistboard/web",
    "dev:persistent": "npm run dev:persistent --workspace @mistboard/server & npm run dev --workspace @mistboard/web",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "env DATABASE_URL=postgres://mistboard:mistboard@localhost:5435/mistboard npm run migrate --workspace @mistboard/server",
    "test:persistent": "env TEST_DATABASE_URL=postgres://mistboard:mistboard@localhost:5435/mistboard npm run test:persistent --workspace @mistboard/server",
    "build": "node scripts/build.mjs",
    "build:all": "npm run build --workspaces",
    "start": "node scripts/start.mjs",
    "engine:enqueue": "npm run engine:enqueue --workspace=@mistboard/server",
    "engine:enqueue-smoke": "npm run engine:enqueue-smoke --workspace=@mistboard/server",
    "engine:enqueue-tournament": "npm run engine:enqueue-tournament --workspace=@mistboard/server",
    "engine:elo-report": "npm run engine:elo-report --workspace=@mistboard/server",
    "engine:queue-status": "npm run engine:queue-status --workspace=@mistboard/server",
    "engine:tournament-status": "npm run engine:tournament-status --workspace=@mistboard/server",
    "worker": "npm run worker --workspace=@mistboard/server",
    "worker:execute": "npm run worker:execute --workspace=@mistboard/server",
    "worker:service": "npm run worker:service --workspace=@mistboard/server",
    "worker:dev": "npm run worker:dev --workspace=@mistboard/server",
    "worker:dev:execute": "npm run worker:dev:execute --workspace=@mistboard/server",
    "worker:dev:service": "npm run worker:dev:service --workspace=@mistboard/server",
    "engine:artifact-archive": "node scripts/archive-engine-artifact.mjs",
    "engine:artifact-audit": "node scripts/engine-artifact-audit.mjs",
    "engine:artifact-closeout": "node scripts/engine-artifact-closeout.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "hooks:install": "git config core.hooksPath .githooks",
    "visual:check": "node scripts/visual-check.mjs",
    "engine:capture-beliefs": "node scripts/capture-belief-artifacts.mjs",
    "prod:smoke": "node scripts/prod-smoke.mjs",
    "prod:smoke:engines": "node scripts/prod-engine-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
