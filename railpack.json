{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22",
    "python": "3.11"
  },
  "steps": {
    "build": {
      "commands": [
        "mkdir -p ~/.ssh && chmod 700 ~/.ssh",
        "echo \"$MISTBOARD_ENGINE_DEPLOY_KEY\" | base64 -di > ~/.ssh/id_ed25519 && chmod 600 ~/.ssh/id_ed25519",
        "ssh-keyscan -t ed25519 github.com >> ~/.ssh/known_hosts 2>/dev/null",
        "git clone git@github.com:brianhliou/mistboard-engine.git /app/mistboard-engine && git -C /app/mistboard-engine checkout ${MISTBOARD_ENGINE_REF:-main} && echo \"engine SHA: $(git -C /app/mistboard-engine rev-parse HEAD)\"",
        "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal",
        { "path": "/root/.cargo/bin" },
        "pip install maturin",
        "python -m maturin build --release -m /app/mistboard-engine/fow_rust/Cargo.toml && ls /app/mistboard-engine/fow_rust/target/wheels/",
        "...",
        "python -m pip install --target /app/mistboard-engine/vendor /app/mistboard-engine/fow_rust/target/wheels/*.whl '/app/mistboard-engine[postgres]'"
      ]
    }
  },
  "deploy": {
    "aptPackages": ["stockfish"]
  }
}
